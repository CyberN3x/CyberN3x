{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 10,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "network",
    "cpu",
    "memory",
    "pulseaudio",
    "tray"
  ],
  
  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "format": "{name}",
    "on-click": "activate"
  },
  
  "hyprland/window": {
    "max-length": 50,
    "format": "{}",
    "separate-outputs": false
  },
  
  "clock": {
    "format": "{:%I:%M %p}",
    "format-alt": "{:%Y-%m-%d}",
    "tooltip": true,
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ff4c4c'><b>{}</b></span>",
        "days": "<span color='#44ffff'>{}</span>",
        "weeks": "<span color='#999999'>W{}</span>",
        "weekdays": "<span color='#ffaa00'>{}</span>",
        "today": "<span color='#ff4c4c'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  
  "network": {
    "interval": 2,
    "format-wifi": "NET {bandwidthDownBytes}",
    "format-ethernet": "ETH {bandwidthDownBytes}",
    "format-wifi": " {essid} ({signalStrength}%)",
    "format-disconnected": "OFFLINE",
    "tooltip-format": "{ifname}: {ipaddr}\nUp: {bandwidthUpBytes}\nDown: {bandwidthDownBytes}"
  },
  
  "cpu": {
    "interval": 2,
    "format": "CPU {usage}%",
    "tooltip": true
  },
  
  "memory": {
    "interval": 5,
    "format": "RAM {used:0.1f}G / {total:0.1f}G",
    "tooltip-format": "Used: {used:0.2f}GiB\nAvailable: {avail:0.2f}GiB"
  },

  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "MUTE",
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "tooltip-format": "{desc}\n{volume}%"
  },
  
  "tray": {
    "icon-size": 16,
    "spacing": 8
  }
}

